# Normaliza los finales de línea para que gofmt y las pruebas sean
# reproducibles en todas las plataformas (evita que core.autocrlf de Windows
# convierta los archivos .go a CRLF).
* text=auto eol=lf

*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.tmpl  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.sh    text eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.exe   binary
*.ico   binary
*.png   binary
*.icns  binary
