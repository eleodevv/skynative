[package]
name = "{{.NombrePaquete}}"
version = "{{.Version}}"
description = "Aplicación de escritorio generada con Skynative"
authors = ["Skynative"]
edition = "2021"
rust-version = "1.77"

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = [] }

[profile.release]
panic = "abort"
codegen-units = 1
lto = true
opt-level = "s"
strip = true
